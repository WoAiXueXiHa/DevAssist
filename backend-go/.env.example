# 从 backend-go 运行时自动读取 ../ai-py/.env 的共享 MySQL/JWT/内部凭证。
# 容器部署请显式注入共享变量；不要覆盖已经配置的 JWT_SECRET 或数据库密码。
GO_LISTEN_ADDR=127.0.0.1:8080
PYTHON_AI_URL=http://127.0.0.1:8000
AI_TIMEOUT_SECONDS=180
KNOWLEDGE_DIR=../data/knowledge
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=3
# 两个服务必须相同；在 ai-py/.env 生成一次，不提交到版本库。
# INTERNAL_SERVICE_TOKEN=
