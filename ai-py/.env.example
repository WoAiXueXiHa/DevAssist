# ===== LLM / Embedding / Rerank (通义 DashScope) =====
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_SMALL=qwen-turbo
LLM_MODEL_LARGE=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank-v2

# ===== 基础设施 =====
# 注：宿主机端口已错开常用端口，避免与本机其它服务冲突
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=devsupport
MYSQL_PASSWORD=devsupport123
MYSQL_DB=devsupport

MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=knowledge_chunk

REDIS_URL=redis://localhost:6380/0

# ===== 认证 =====
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== 业务阈值 =====
INTENT_CONFIDENCE_THRESHOLD=0.6
RAG_SCORE_THRESHOLD=0.3
TOOL_TIMEOUT_SECONDS=3
SEMANTIC_CACHE_SIM_THRESHOLD=0.95

# ===== 其它 =====
APP_ENV=dev
LOG_LEVEL=INFO

# ===== Go 业务后端 + Python 内部 AI =====
# 用 python -c 'import secrets; print(secrets.token_urlsafe(48))' 本地生成并填入 .env。
INTERNAL_SERVICE_TOKEN=
GO_TOOLS_URL=http://127.0.0.1:8080
BUSINESS_TOOLS_BACKEND=go
# 以下共享配置也由 Go 从此文件读取；Go 可用自己的 .env 覆盖监听/连接配置。
GO_LISTEN_ADDR=127.0.0.1:8080
PYTHON_AI_URL=http://127.0.0.1:8000
AI_TIMEOUT_SECONDS=180
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=3
